# Copy to server/.env and adjust. The local defaults match docker-compose.yml.

# --- Postgres ---
# Local (docker-compose): port 5433. For AWS, point this at your RDS endpoint.
DATABASE_URL=postgres://polling:polling@localhost:5433/polling
# Set to "true" when connecting to RDS with SSL enforced.
PGSSL=false
# Max DB connections PER WORKER. With 4 workers, 10 each = 40 total to Postgres.
# Keep this well under your RDS max_connections.
PG_POOL_MAX=10

# --- Redis ---
# Local (docker-compose): port 6380. For AWS, point at your ElastiCache endpoint.
REDIS_URL=redis://localhost:6380

# --- Server ---
PORT=8080
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-insecure-secret-change-me
# Token the host enters in the /admin panel to control the poll. Set a strong
# value in production.
ADMIN_TOKEN=admin-dev-token
# If true, the poll starts automatically on boot. Default false: it waits idle
# until the host clicks Start in /admin.
AUTO_START=false
# Number of cluster workers. Defaults to (cpu cores - 1) if unset.
# WORKERS=4
# Allowed frontend origin(s) for CORS, comma-separated. Leave empty in dev to
# allow any origin. In production set to your Vercel URL (and custom domain):
#   CORS_ORIGIN=https://your-poll.vercel.app
CORS_ORIGIN=

# --- Poll timing (seconds) ---
# How long each question accepts votes.
VOTE_SECONDS=30
# Interlude showing the result/leaderboard before the next question opens.
RESULTS_SECONDS=8
# Delay before the very first question opens (lobby time).
LOBBY_SECONDS=15

# --- Scoring ---
# Points awarded for selecting the 1st / 2nd / 3rd most-voted option.
# Comma-separated, highest rank first.
SCORE_WEIGHTS=3,2,1
# How many top options count as "winning" per question (length should match weights).
TOP_N_SCORING=3
