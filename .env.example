DB_HOST=datab......
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_PORT=5432
PGSSL=require
PG_POOL_MAX=10
REDIS_URL=redis://localhost:6380
SESSION_SECRET=local-dev-secret
ADMIN_TOKEN=admin-dev-token
AUTO_START=false
WORKERS=2

# Allowed CORS origin(s) for the React frontend (comma-separated, no trailing slash).
CORS_ORIGIN=https://polling-blond.vercel.app

# Short timings so the smoke test runs fast.
VOTE_SECONDS=60
RESULTS_SECONDS=10
LOBBY_SECONDS=20

SCORE_WEIGHTS=3,2,1
TOP_N_SCORING=3
